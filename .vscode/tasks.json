{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Em: Start Web Server",
			"type": "shell",
			"command": "python3 -m http.server 58000",
			"isBackground": true,
			"runOptions": {
				"instanceLimit": 1
			},
			"problemMatcher": {
				"pattern": {
					"regexp": ".",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Serving HTTP on .* port ([0-9]+)"
				}
			},
			"presentation": {
				"panel": "dedicated",
				"reveal": "always"
			},
			"icon": {
				"id": "globe",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "Em: Configure",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset",
				"emscripten"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"presentation": {
				"reveal": "silent"
			},
			"icon": {
				"id": "gear",
				"color": "terminal.ansiMagenta"
			}
		},
		{
			"label": "Em: Build Test",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build_em",
				"--config",
				"RelWithDebInfo",
				"--target",
				"test"
			],
			"dependsOn": "Em: Configure",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"presentation": {
				"reveal": "silent"
			},
			"icon": {
				"id": "tools",
				"color": "terminal.ansiYellow"
			}
		},
		{
			"label": "Em: Build Current",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build_em",
				"--config",
				"RelWithDebInfo",
				"--target",
				"${command:cmake.buildTargetName}"
			],
			"dependsOn": "Em: Configure",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"presentation": {
				"reveal": "silent"
			},
			"icon": {
				"id": "tools",
				"color": "terminal.ansiYellow"
			}
		},
		{
			"label": "Em: Launch Current (Safari)",
			"type": "shell",
			"command": "open",
			"args": [
				"-a",
				"Safari",
				"http://localhost:58000/build_em/examples/RelWithDebInfo/${command:cmake.buildTargetName}/"
			],
			"dependsOn": "Em: Build Current",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"runOptions": {
				"instanceLimit": 1
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"focus": false,
				"close": true
			},
			"icon": {
				"id": "play",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "Em: Launch Current (Firefox)",
			"type": "shell",
			"command": "open",
			"args": [
				"-a",
				"Firefox",
				"http://localhost:58000/build_em/examples/RelWithDebInfo/${command:cmake.buildTargetName}/"
			],
			"dependsOn": "Em: Build Current",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"runOptions": {
				"instanceLimit": 1
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"focus": false,
				"close": true
			},
			"icon": {
				"id": "play",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "iOS: Console",
			"type": "shell",
			"command": "touch /tmp/aether-ios-console.log && echo '==> iOS: Console ready (tailing /tmp/aether-ios-console.log)' && exec tail -F /tmp/aether-ios-console.log",
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": ".",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "NEVER_MATCHES_qweRtY12345",
					"endsPattern": "iOS: Console ready"
				}
			},
			"runOptions": {
				"instanceLimit": 1
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": false,
				"clear": false
			},
			"icon": {
				"id": "device-mobile",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "iOS: Clean All",
			"type": "shell",
			"command": "rm",
			"args": [
				"-rf",
				"${workspaceFolder}/build_ios"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "never",
				"revealProblems": "never",
				"panel": "dedicated",
				"focus": false,
				"clear": true
			},
			"icon": {
				"id": "trash",
				"color": "terminal.ansiRed"
			}
		},
		{
			"label": "iOS: Configure",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/ios_configure.py"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false,
				"clear": true
			},
			"icon": {
				"id": "gear",
				"color": "terminal.ansiMagenta"
			}
		},
		{
			"label": "iOS: Build Current",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/ios_build.py",
				"${command:cmake.buildTargetName}",
				"RelWithDebInfo"
			],
			"dependsOn": "iOS: Configure",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build",
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false,
				"clear": true
			},
			"icon": {
				"id": "tools",
				"color": "terminal.ansiYellow"
			}
		},
		{
			"label": "iOS: Install Current",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/ios-install.sh",
			"args": [
				"${workspaceFolder}/build_ios/examples/RelWithDebInfo-iphoneos/${command:cmake.getLaunchTargetName}.app"
			],
			"dependsOn": "iOS: Build Current",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false,
				"clear": true
			},
			"icon": {
				"id": "device-mobile",
				"color": "terminal.ansiYellow"
			}
		},
		{
			"label": "iOS: Launch Current",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/ios-launch.sh",
			"args": [
				"--console",
				"${workspaceFolder}/build_ios/examples/RelWithDebInfo-iphoneos/${command:cmake.getLaunchTargetName}.app"
			],
			"dependsOn": "iOS: Install Current",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false,
				"clear": true
			},
			"icon": {
				"id": "play",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "iOS: Launch Current (Paused)",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/ios-launch.sh",
			"args": [
				"--start-paused",
				"--console",
				"${workspaceFolder}/build_ios/examples/RelWithDebInfo-iphoneos/${command:cmake.getLaunchTargetName}.app"
			],
			"dependsOn": [
				"iOS: Install Current",
				"iOS: Console"
			],
			"dependsOrder": "parallel",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false,
				"clear": true
			},
			"icon": {
				"id": "debug-pause",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "iOS: Stop All",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/ios-stop.sh",
			"args": [
				"--all"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"focus": false,
				"clear": true
			},
			"icon": {
				"id": "debug-stop",
				"color": "terminal.ansiRed"
			}
		}
	]
}
