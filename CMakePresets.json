{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 21,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "macos",
			"displayName": "macOS",
			"description": "Native desktop build for macOS. Compile commands exported for clangd.",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build_vscode",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"AE_LEAN_AND_MEAN": "OFF",
				"AE_LOADERS_OFBX": "ON",
				"AE_DEPRECATED": "ON"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "linux",
			"displayName": "Linux",
			"description": "Native desktop build for Linux. Compile commands exported for clangd.",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build_vscode",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"AE_LEAN_AND_MEAN": "OFF",
				"AE_LOADERS_OFBX": "ON",
				"AE_DEPRECATED": "ON"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "ios",
			"displayName": "iOS",
			"description": "iOS device build using ios-cmake toolchain. Per-developer values (team ID, device UDID) live in scripts/config.env (gitignored, copy from scripts/config.env.example). Configure via scripts/ios_configure.py, which injects AE_APPLE_DEVELOPMENT_TEAM from config.env so it is baked into the generated Xcode project. Xcode handles provisioning via -allowProvisioningUpdates.",
			"generator": "Xcode",
			"binaryDir": "${sourceDir}/build_ios",
			"toolchainFile": "${sourceDir}/scripts/ios.toolchain.cmake",
			"cacheVariables": {
				"PLATFORM": "OS64",
				"DEPLOYMENT_TARGET": "15.0",
				"ENABLE_BITCODE": "OFF",
				"ENABLE_ARC": "ON",
				"AE_LEAN_AND_MEAN": "OFF",
				"AE_LOADERS_OFBX": "ON",
				"AE_DEPRECATED": "ON"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "ios-coverage",
			"displayName": "iOS (coverage sweep)",
			"description": "Same as the ios preset, in its own build directory so scripts/coverage_build.sh does not share a cache with the editor's iOS build.",
			"inherits": "ios",
			"binaryDir": "${sourceDir}/build_coverage_ios"
		},
		{
			"name": "wasi",
			"displayName": "Web (wasi-sdk)",
			"description": "Web build with wasi-sdk, hosted in the browser by aether.js. Requires the WASI_SDK_PATH env var in the shell, set to the wasi-sdk install directory.",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build_wasi",
			"toolchainFile": "$env{WASI_SDK_PATH}/share/cmake/wasi-sdk-p1.cmake",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"AE_LEAN_AND_MEAN": "OFF",
				"AE_LOADERS_OFBX": "ON",
				"AE_DEPRECATED": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "macos-debug",
			"displayName": "Debug",
			"configurePreset": "macos",
			"configuration": "Debug"
		},
		{
			"name": "linux-debug",
			"displayName": "Debug",
			"configurePreset": "linux",
			"configuration": "Debug"
		},
		{
			"name": "ios-debug",
			"displayName": "Debug",
			"configurePreset": "ios",
			"configuration": "Debug",
			"nativeToolOptions": [
				"-allowProvisioningUpdates"
			]
		},
		{
			"name": "ios-coverage-debug",
			"displayName": "Debug (coverage sweep)",
			"configurePreset": "ios-coverage",
			"configuration": "Debug",
			"nativeToolOptions": [
				"-allowProvisioningUpdates"
			]
		},
		{
			"name": "wasi-debug",
			"displayName": "Debug",
			"configurePreset": "wasi",
			"configuration": "Debug"
		},
		{
			"name": "macos-relwithdebinfo",
			"displayName": "RelWithDebInfo",
			"configurePreset": "macos",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "linux-relwithdebinfo",
			"displayName": "RelWithDebInfo",
			"configurePreset": "linux",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "ios-relwithdebinfo",
			"displayName": "RelWithDebInfo",
			"configurePreset": "ios",
			"configuration": "RelWithDebInfo",
			"nativeToolOptions": [
				"-allowProvisioningUpdates"
			]
		},
		{
			"name": "wasi-relwithdebinfo",
			"displayName": "RelWithDebInfo",
			"configurePreset": "wasi",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "macos-release",
			"displayName": "Release",
			"configurePreset": "macos",
			"configuration": "Release"
		},
		{
			"name": "linux-release",
			"displayName": "Release",
			"configurePreset": "linux",
			"configuration": "Release"
		},
		{
			"name": "ios-release",
			"displayName": "Release",
			"configurePreset": "ios",
			"configuration": "Release",
			"nativeToolOptions": [
				"-allowProvisioningUpdates"
			]
		},
		{
			"name": "wasi-release",
			"displayName": "Release",
			"configurePreset": "wasi",
			"configuration": "Release"
		}
	]
}
