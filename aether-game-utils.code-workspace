{
	"folders": [
		{
			"path": "."
		}
	],
	"extensions": {
		"recommendations": [
			"llvm-vs-code-extensions.lldb-dap",
			"ms-vscode.cmake-tools",
			"ms-vscode.cpptools"
		]
	},
	"settings": {
		"clangd.arguments": [
			// @TODO: Should have a consistent path for all build types, maybe symlinked
			"--compile-commands-dir=${workspaceFolder}/build_vscode",
		],
		"cmake.useCMakePresets": "always",
		"cmake.copyCompileCommands": "${workspaceFolder}/build_vscode/compile_commands.json",
		"explorer.excludeGitIgnore": true,
		"files.associations": {
			"**/aether.h": "objective-cpp"
		},
		"lldb-dap.executable-path": "/Applications/Xcode.app/Contents/Developer/usr/bin/lldb-dap"
	}
	// Tasks and launch configurations live in .vscode/tasks.json and
	// .vscode/launch.json. VS Code reports a live instance when re-running a
	// task declared in a .code-workspace file, prompts with an empty instance
	// list, and never runs the command, which prevents Safari from launching.
}
